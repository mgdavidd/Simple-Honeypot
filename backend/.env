# Base de datos
DATABASE_URL=postgresql://honeypot:honeypot@postgres:5432/honeypot

# API
API_URL=http://api:8000
DOCKER_NETWORK=honeypot-net

# Seguridad
SECRET_KEY=your-super-secret-key-change-this-in-production-12345
COOKIE_SECURE=False
COOKIE_NAME=honeypot_auth_token

# Puertos por defecto
SSH_PORT_1=2222
SSH_PORT_2=2223
HTTP_PORT_1=8081
HTTP_PORT_2=8082
MYSQL_PORT_1=3307
MYSQL_PORT_2=3308

# Límites de recursos - SSH
SSH_MEMORY=256m
SSH_CPU=0.5
SSH_PIDS=200

# Límites de recursos - HTTP
HTTP_MEMORY=128m
HTTP_CPU=0.25
HTTP_PIDS=50

# Límites de recursos - MySQL
MYSQL_MEMORY=512m
MYSQL_CPU=1.0
MYSQL_PIDS=100

# Thresholds de seguridad - SSH
SSH_BAN_SECONDS=600
SSH_FAILED_THRESHOLD=20

# Thresholds de seguridad - HTTP
HTTP_BAN_SECONDS=600
HTTP_FAILED_THRESHOLD=20
HTTP_RATE_LIMIT_THRESHOLD=30
HTTP_RATE_LIMIT_WINDOW=15

# MySQL Templates
MYSQL_TEMPLATES_DIR=/app/backend/honeypot_templates
MYSQL_DEFAULT_PASSWORD=password123
MYSQL_DEFAULT_USER=honeypot
MYSQL_DEFAULT_DB=honeypot
MYSQL_ROOT_PASSWORD=change-password

# Imágenes Docker (opcional, usa defaults si no se especifica)
DOCKER_IMAGE_SSH=honeypot-ssh:v3
DOCKER_IMAGE_HTTP=honeypot-http:v1
DOCKER_IMAGE_MYSQL=honeypot-mysql:v1